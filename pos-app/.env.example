# Copy this file to .env and fill in the values from your Supabase project's
# API settings (Project Settings > API). The anon key is safe to ship inside
# the built APK — Supabase's security model relies on RLS policies, not on
# keeping this key secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
